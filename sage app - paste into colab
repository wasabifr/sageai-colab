def make_chatbot():
    kw = dict(value=load_history(), height=560, label="Chat")
    for extra in (dict(type="messages", show_copy_button=True),
                  dict(show_copy_button=True), {}):
        try:
            return gr.Chatbot(**kw, **extra)
        except TypeError:
            continue
    return gr.Chatbot(**kw)

with gr.Blocks(theme=theme, css=css, fill_height=True, title="Local Colab Agent") as demo:
    gr.Markdown(
        "### Local Colab Agent\n"
        "Streaming tokens · web search · disk chat history · Hugging Face cache · Pascal+ GPU path"
    )
    gr.Markdown(status_md, elem_id="status")
    chatbot = make_chatbot()
    with gr.Row():
        msg = gr.Textbox(
            placeholder="Ask anything…  (Shift+Enter for newline)",
            scale=5, show_label=False, autofocus=True, lines=1,
        )
        send = gr.Button("Send", variant="primary", scale=1)
        stop = gr.Button("Stop", variant="stop", scale=1)
    with gr.Accordion("Settings", open=False):
        with gr.Row():
            temperature = gr.Slider(0.0, 1.2, value=0.7, step=0.05, label="Temperature")
            max_new = gr.Slider(64, 2048, value=512, step=64, label="Max new tokens")
        force = gr.Checkbox(False, label="Force web search on every turn")
        with gr.Row():
            clear = gr.Button("Clear history")
            reload_h = gr.Button("Reload saved history")
    gr.Examples(
        examples=[
            "What is NVIDIA Pascal vs Ampere compute capability?",
            "Latest stable Python version and release date",
            "Summarize what an AI agent is, then search for a notable 2024 agent paper",
        ],
        inputs=msg,
    )

    def on_chat(message, history, temperature, max_new, force):
        """Single generator: clear box, append user turn, stream tokens. No .then() race."""
        STOP.clear()
        text = _user_text(message).strip()
        history = history or []
        if not text:
            yield "", history
            return
        history = history + [{"role": "user", "content": text}]
        yield "", history
        try:
            for h in agent_stream(history, temperature, max_new, force, STOP):
                yield "", h
        except Exception:
            err = traceback.format_exc().splitlines()[-1]
            yield "", history + [{"role": "assistant", "content": f"Generation error: {err}"}]

    def on_stop():
        STOP.set()
        return gr.update()

    def on_clear():
        STOP.set()
        save_history([])
        return []

    def on_reload():
        return load_history()

    chat_kw = dict(
        fn=on_chat,
        inputs=[msg, chatbot, temperature, max_new, force],
        outputs=[msg, chatbot],
    )
    sub = msg.submit(**chat_kw)
    clk = send.click(**chat_kw)
    stop.click(on_stop, cancels=[sub, clk])
    clear.click(on_clear, outputs=chatbot, cancels=[sub, clk])
    reload_h.click(on_reload, outputs=chatbot)

print(f"Gradio {gr.__version__}")
try:
    demo.queue(default_concurrency_limit=1)
except TypeError:
    demo.queue()
demo.launch(share=True, show_error=True)
