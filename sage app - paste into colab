PERSIST_ON_DRIVE  = False   # True → model cache + history on Google Drive
FORCE_4BIT        = False   # True → 4-bit even on big GPUs (needs CC>=7.5)
GPU_CC_MIN        = 6       # Pascal = 6.0
BNB_CC_MIN        = 7.5     # bitsandbytes 4-bit is reliable on Turing+
MAX_HISTORY_TURNS = 12
MAX_INPUT_TOKENS  = 3072
MAX_SEARCH_LOOPS  = 2

